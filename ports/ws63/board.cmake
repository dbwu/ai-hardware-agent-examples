set(WS63_BOARD "hoperun" CACHE STRING "WS63 board directory under boards/")
if(NOT WS63_BOARD MATCHES "^[a-z][a-z0-9_-]*$")
    message(FATAL_ERROR "Invalid WS63_BOARD")
endif()
if(DEFINED WS63_CONFIGURED_BOARD AND NOT WS63_CONFIGURED_BOARD STREQUAL WS63_BOARD)
    message(FATAL_ERROR "Use a separate build directory for each WS63 board")
endif()
set(WS63_CONFIGURED_BOARD "${WS63_BOARD}" CACHE INTERNAL "Configured WS63 board")
set(ws_board_dir "${app_root}/boards/${WS63_BOARD}")
if(NOT EXISTS "${ws_board_dir}/board.cmake")
    message(FATAL_ERROR "Missing boards/${WS63_BOARD}/board.cmake")
endif()
include("${ws_board_dir}/board.cmake")
if(NOT WS63_BOARD_SOURCES OR NOT GOLDIEOS_ROOT)
    message(FATAL_ERROR "Board must define WS63_BOARD_SOURCES and GOLDIEOS_ROOT")
endif()
